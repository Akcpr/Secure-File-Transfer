# Copy this file to .env and fill in your own values before running.
# .env is listed in .gitignore and must never be committed.

# -------------------------------------------------------------------
# Server configuration
# -------------------------------------------------------------------

# SHA-256 hash of the master password used to authorize admin account creation.
# To generate: run python -c "import hashlib; print(hashlib.sha256(b'YOUR_MASTER_PASSWORD').hexdigest())"
# Replace the value below with your own hash.
MASTER_HASH=your_master_password_hash_here

# -------------------------------------------------------------------
# Client configuration
# -------------------------------------------------------------------

# Secret pepper mixed into password hashes.
# Must be the SAME value on every client that connects to the same server.
# Change this from the default for any real deployment.
PASSWORD_PEPPER=your_pepper_value_here
